{
  "name": "makepace",
  "version": "0.2.0-alpha.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alonsosolisg/makepace.git"
  },
  "private": true,
  "type": "module",
  "main": "dist/app/desktop/main.cjs",
  "description": "Your adaptive content powerhouse",
  "author": "MakePace",
  "scripts": {
    "build": "tsx scripts/build.mts",
    "dev": "npm run build && node dist/app/scripts/serve-community-preview.mjs",
    "studio": "npm run dev",
    "test": "npm run build && cd dist/app && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.strict.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build:site": "npm run build && node dist/app/scripts/build-site.mjs",
    "desktop": "npm run build && electron .",
    "desktop:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File desktop/run-windows.ps1",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "puppeteer-core": "^25.10.0",
    "@openai/codex": "0.164.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "typescript": "~5.9.3",
    "tsx": "^4.20.6",
    "esbuild": "^0.25.12",
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.46.4",
    "prettier": "^3.6.2"
  },
  "build": {
    "appId": "app.makepace.desktop",
    "productName": "MakePace",
    "artifactName": "MakePace-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "dist/app/desktop/**",
      "dist/app/scripts/studio/**",
      "dist/app/scripts/feed-preview/**",
      "dist/app/scripts/serve-community-preview.mjs",
      "dist/app/landing/**",
      "dist/app/package.json",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@openai/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "scripts/studio/public/icons/icon-512.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "scripts/studio/public/icons/icon-512.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "scripts/studio/public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
